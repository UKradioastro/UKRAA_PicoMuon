# legacy serial data for UKRAA PicoMuon
# Set these to the detector's actual settings before starting collection.
# Used when the detector omits all four settings. Processing also uses these
# values as an explicit logged assumption for historic rows lacking settings.
# Values must be non-negative integers in the units used by the detector firmware.
# Restart collection after editing if you need an unambiguous observation boundary.
[legacy]
threshold_top = 200
reset_top = 100
threshold_bottom = 200
reset_bottom = 100

# Phase 2a pilot: named units require their OWN complete section.
# There is no fallback from [legacy:LABEL] to [legacy] or [DEFAULT].
# Values below are illustrative: set each unit's actual firmware settings.
# [legacy:unit_1]
# threshold_top = 200
# reset_top = 100
# threshold_bottom = 200
# reset_bottom = 100
#
# [legacy:unit_2]
# threshold_top = 250
# reset_top = 120
# threshold_bottom = 250
# reset_bottom = 120