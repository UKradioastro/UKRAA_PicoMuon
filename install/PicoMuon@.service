[Unit]
Description=UKRAA PicoMuon detector %i (Phase 2a collection pilot)
After=multi-user.target
Conflicts=PicoMuon.service PicoMuonACM0.service

[Service]
Type=simple
User=@PICOMUON_USER@
Group=@PICOMUON_GROUP@
SupplementaryGroups=dialout
WorkingDirectory=@PICOMUON_BASE_PATH@
Environment="PICOMUON_BASE_PATH=@PICOMUON_BASE_PATH@"
Environment=TERM=dumb
ExecStart=/usr/bin/python3 "@PICOMUON_BASE_PATH@/scripts/GetDataRaw.py" --detector %i
StandardOutput=append:@PICOMUON_BASE_PATH@/logfiles/detectors/%i/log-PicoMuon.txt
StandardError=append:@PICOMUON_BASE_PATH@/logfiles/detectors/%i/log-error.txt
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
